<?xml version="1.0"?>
<package format="2">
  <name>multi_robot_formation</name>
  <version>0.0.0</version>
  <description>
    Triangle, square and pentagon formation controllers that send coordinated
    move_base goals to namespaced TurtleBot3 robots (tb3_0 to tb3_4).
  </description>
  <maintainer email="adithyapothula123@gmail.com">Adithya Pothula</maintainer>
  <license>Apache License 2.0</license>
  <url type="repository">https://github.com/adithya2204/multi_robot_formation</url>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>rospy</build_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>rospy</build_export_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>

  <export>
  </export>
</package>
